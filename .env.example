# MCP Security Sandbox Environment Configuration

# ---------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------
# The password used to access the dashboard (Basic Auth username is always 'admin')
ADMIN_PASSWORD=supersecret

# ---------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------
# Port to run the Express server on (defaults to 3000)
# PORT=3000

# Ngrok Authentication Token
# If provided, the server will automatically spin up a secure, public tunnel to the dashboard
# Get this from https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=your_ngrok_auth_token_here
